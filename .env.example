# ============================================================
# RAG System - Environment Configuration (Template)
# ============================================================
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to version control.
# ============================================================


# ============================================================
# Application
# ============================================================
APP_NAME=RAG System
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO


# ============================================================
# LLM Provider (Groq - OpenAI-compatible API)
# ============================================================
LLM_PROVIDER=groq

# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT=90
GROQ_MAX_RETRIES=5

# Groq free-tier rate-limit throttling
GROQ_MIN_REQUEST_INTERVAL=2.5
GROQ_RETRY_BACKOFF_MULTIPLIER=2.0
GROQ_RETRY_BACKOFF_MAX=60.0


# ============================================================
# Embeddings (local, no API key needed)
# ============================================================
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
# cpu | cuda | mps | auto
EMBEDDING_DEVICE=cpu


# ============================================================
# API Server
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000


# ============================================================
# Retrieval (defaults - tune per deployment)
# ============================================================
DENSE_TOP_K=50
BM25_TOP_K=50
RRF_K=60
RERANKER_TOP_K=10


# ============================================================
# Generation
# ============================================================
GENERATION_MAX_TOKENS=2048
GENERATION_TEMPERATURE=0.0
